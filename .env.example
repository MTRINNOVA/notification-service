# Ejemplo de variables de entorno para notification-service.
# SOLO PLACEHOLDERS FICTICIOS. Copiar a .env (ignorado por Git) y completar fuera del repositorio.
# En producción, inyectar los valores sensibles desde secretos de Docker/Portainer o un secret manager.
# Se añadirán nuevas variables solo cuando la fase que las use esté autorizada
# (nombres de referencia: docs/deployment/compose-topology.md).

# Entorno (.NET). Valores: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production

# PostgreSQL (Api, Worker y Scheduler). Única convención admitida.
ConnectionStrings__DefaultConnection=Host=<postgres-host>;Port=5432;Database=<database>;Username=<user>;Password=<password>

# Exponer OpenAPI/Swagger UI fuera de Development (por defecto: false).
OpenApi__Enabled=false
