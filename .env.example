# Ejemplo de variables de entorno para notification-service.
# SOLO PLACEHOLDERS FICTICIOS. Copiar a .env (ignorado por Git) y completar fuera del repositorio.
# En producción, inyectar valores sensibles desde Docker Secrets/Portainer o un secret manager.

# -----------------------------------------------------------------------------
# Entorno de hosts .NET (valores típicos: Development | Staging | Production)
# -----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production
ASPNETCORE_ENVIRONMENT_DEV=Development
DOTNET_ENVIRONMENT_DEV=Development

# OpenAPI/Swagger fuera de Development (solo API).
OpenApi__Enabled=false
OpenApi__Enabled_DEV=true

# -----------------------------------------------------------------------------
# Imágenes de aplicación (producción: GHCR, tags explícitos o digest)
# -----------------------------------------------------------------------------
NOTIFICATION_IMAGE_TAG=dev
NOTIFICATION_API_IMAGE=ghcr.io/mtrinnova/notification-api:dev
NOTIFICATION_WORKER_IMAGE=ghcr.io/mtrinnova/notification-worker:dev
NOTIFICATION_SCHEDULER_IMAGE=ghcr.io/mtrinnova/notification-scheduler:dev

# Etiquetas locales de desarrollo cuando se construye con compose.dev.yaml
NOTIFICATION_API_IMAGE_DEV=notification-api:dev
NOTIFICATION_WORKER_IMAGE_DEV=notification-worker:dev
NOTIFICATION_SCHEDULER_IMAGE_DEV=notification-scheduler:dev

# -----------------------------------------------------------------------------
# Infraestructura: imágenes fijadas por versión explícita (sin latest)
# -----------------------------------------------------------------------------
# Verificadas en imágenes oficiales/publicadas:
# - postgres:17.12-alpine3.24 (Docker Official Image)
# - rabbitmq:4.4.1-management-alpine (Docker Official Image)
# - redis:7.4.12-alpine (Docker Official Image)
# - minio/minio:RELEASE.2025-10-15T17-29-55Z (release pública de MinIO)
POSTGRES_IMAGE=postgres:17.12-alpine3.24
RABBITMQ_IMAGE=rabbitmq:4.4.1-management-alpine
REDIS_IMAGE=redis:7.4.12-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-10-15T17-29-55Z

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=notification_service
POSTGRES_USER=notification_user
POSTGRES_PASSWORD=<postgres-password>

# Variable consumida por la aplicación (única convención admitida).
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=notification_service;Username=notification_user;Password=<postgres-password>

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=notification
RABBITMQ_DEFAULT_PASS=<rabbitmq-password>
RABBITMQ_DEFAULT_VHOST=/notification

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PASSWORD=<redis-password>

# -----------------------------------------------------------------------------
# MinIO
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=<minio-root-user>
MINIO_ROOT_PASSWORD=<minio-root-password>

# -----------------------------------------------------------------------------
# Redes y volúmenes
# -----------------------------------------------------------------------------
NOTIFICATION_INTERNAL_NETWORK=notification_internal
NOTIFICATION_PROVIDERS_NETWORK=notification_providers
TRAEFIK_NETWORK_NAME=traefik

POSTGRES_VOLUME_NAME=notification_postgres_data
RABBITMQ_VOLUME_NAME=notification_rabbitmq_data
REDIS_VOLUME_NAME=notification_redis_data
MINIO_VOLUME_NAME=notification_minio_data

# -----------------------------------------------------------------------------
# Puertos locales (solo compose.dev.yaml, vinculados a 127.0.0.1)
# -----------------------------------------------------------------------------
API_HTTP_PORT=8080
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# Hosts para reglas de Traefik (los lee Compose; no los consume la aplicación)
# -----------------------------------------------------------------------------
NOTIFICATIONS_API_HOST=<api-host>
NOTIFICATIONS_ADMIN_HOST=<admin-host>
NOTIFICATIONS_WEBHOOKS_HOST=<webhooks-host>
